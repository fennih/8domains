{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://8domains/kb.schema.json",
  "title": "8Domains compiled domain file",
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 900
    },
    "conceptId": {
      "type": "string",
      "pattern": "^d[1-8]-[a-z0-9-]+$"
    },
    "objective": {
      "type": "string",
      "pattern": "^[1-8]\\.[0-9]+$"
    },
    "priority": {
      "enum": [
        "core",
        "important",
        "nice"
      ]
    },
    "concept": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "domain",
        "objective",
        "title",
        "hook",
        "summary",
        "keyPoints",
        "priority"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/conceptId"
        },
        "domain": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "objective": {
          "$ref": "#/$defs/objective"
        },
        "topic": {
          "type": "string",
          "pattern": "^[1-8]\\.[0-9]+\\.[0-9]+$"
        },
        "title": {
          "type": "string",
          "minLength": 2,
          "maxLength": 90
        },
        "hook": {
          "type": "string",
          "minLength": 10,
          "maxLength": 140
        },
        "summary": {
          "$ref": "#/$defs/text"
        },
        "keyPoints": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/listItem"
          }
        },
        "priority": {
          "$ref": "#/$defs/priority"
        },
        "mnemonic": {
          "$ref": "#/$defs/text"
        },
        "managerView": {
          "$ref": "#/$defs/text"
        },
        "traps": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/listItem"
          }
        },
        "related": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/conceptId"
          }
        }
      }
    },
    "flashcard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "conceptId",
        "type",
        "front",
        "back"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^d[1-8]-[a-z0-9-]+-fc[0-9]+$"
        },
        "conceptId": {
          "$ref": "#/$defs/conceptId"
        },
        "type": {
          "enum": [
            "qa",
            "cloze",
            "compare"
          ]
        },
        "front": {
          "$ref": "#/$defs/text"
        },
        "back": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "domain",
        "objective",
        "conceptIds",
        "stem",
        "options",
        "answer",
        "explanation",
        "style",
        "difficulty"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^d[1-8]-q[0-9]{3}$"
        },
        "domain": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "objective": {
          "$ref": "#/$defs/objective"
        },
        "conceptIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/conceptId"
          }
        },
        "stem": {
          "type": "string",
          "minLength": 10,
          "maxLength": 900
        },
        "options": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        },
        "answer": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "explanation": {
          "type": "string",
          "minLength": 10,
          "maxLength": 1200
        },
        "style": {
          "enum": [
            "manager",
            "technical"
          ]
        },
        "difficulty": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        }
      }
    },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "columns",
        "rows",
        "priority"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^t-[a-z0-9-]+$"
        },
        "domain": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "objective": {
          "$ref": "#/$defs/objective"
        },
        "title": {
          "type": "string",
          "minLength": 2,
          "maxLength": 90
        },
        "description": {
          "$ref": "#/$defs/text"
        },
        "columns": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "items": {
            "type": "string"
          }
        },
        "rows": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 200
            }
          }
        },
        "priority": {
          "$ref": "#/$defs/priority"
        }
      }
    },
    "listItem": {
      "oneOf": [
        {
          "$ref": "#/$defs/text"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text",
            "items"
          ],
          "properties": {
            "text": {
              "$ref": "#/$defs/text"
            },
            "items": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              }
            }
          }
        }
      ]
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "domain",
    "concepts",
    "flashcards",
    "questions",
    "tables"
  ],
  "properties": {
    "domain": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8
    },
    "concepts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/concept"
      }
    },
    "flashcards": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/flashcard"
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/question"
      }
    },
    "tables": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/table"
      }
    }
  }
}
