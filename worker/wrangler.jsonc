{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "8domains",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-19",
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS",
    // Everything under /app goes through the session check; the landing is served directly.
    "run_worker_first": ["/app", "/app/*"],
    "not_found_handling": "none"
  },
  "routes": [{ "pattern": "8domains.valerio.fyi", "custom_domain": true }],
  "vars": {
    "APP_ORIGIN": "https://8domains.valerio.fyi",
    "SIGN_IN_URL": "https://accounts.8domains.valerio.fyi/sign-in",
    // Public key of the Clerk production instance; CI passes it from the CLERK_PUBLISHABLE_KEY repo variable.
    "CLERK_PUBLISHABLE_KEY": ""
  },
  // Secrets, set with `wrangler secret put`: CLERK_SECRET_KEY, CLERK_JWT_KEY.
  "observability": { "enabled": true }
}
